trainer.example.com {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control no-store
    }
    handle /api/* {
        request_body {
            max_size 300000
        }
        reverse_proxy 127.0.0.1:4317
    }
    handle {
        root * /srv/pole/dist
        try_files {path} /index.html
        file_server
    }
}
