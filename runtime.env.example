# Documentation only: set these in your own server shell; no automatic dotenv loading.
# Local mode uses your own installed Codex CLI/login by default.
POLE_MODE=local
POLE_TUTOR_PROVIDER=codex
# Optional alternative, using your own provider account:
# POLE_TUTOR_PROVIDER=openai
# OPENAI_API_KEY=YOUR_API_KEY
# OPENAI_MODEL=YOUR_AVAILABLE_MODEL_ID
# Default new local database (never point to an existing user's database):
# POLE_DB_PATH=.runtime/pole.sqlite
# Frontend subpath only when building for a subpath:
# VITE_APP_BASE=/mathmaxing/
